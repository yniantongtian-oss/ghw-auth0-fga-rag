# Auth0 login. The dev tenant is the default domain.
# Leave CLIENT_ID empty to use the in-app employee switcher instead.
AUTH0_DOMAIN=dev-wvxvhbnjrgvgn26x.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:8000/callback
SESSION_SECRET=replace-me
# DEV_USER_SWITCHER defaults to true when AUTH0_CLIENT_ID is empty.
DEV_USER_SWITCHER=true

# Leave FGA_API_URL empty to evaluate model.fga in-process (fully offline).
# Local OpenFGA from docker compose:
#   FGA_API_URL=http://localhost:8080
#   FGA_AUTO_BOOTSTRAP=true
# Auth0 FGA cloud (same API, plus client credentials):
#   FGA_API_URL=https://api.us1.fga.dev
#   FGA_STORE_ID=
#   FGA_CLIENT_ID=
#   FGA_CLIENT_SECRET=
#   FGA_API_AUDIENCE=https://api.us1.fga.dev/
#   FGA_API_TOKEN_ISSUER=https://auth.fga.dev
#   FGA_AUTHORIZATION_MODEL_ID=
#   FGA_AUTO_BOOTSTRAP=false
FGA_API_URL=
FGA_STORE_ID=
FGA_STORE_NAME=hearth-hr
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=
FGA_API_AUDIENCE=
FGA_API_TOKEN_ISSUER=https://auth.fga.dev
FGA_AUTHORIZATION_MODEL_ID=
FGA_AUTO_BOOTSTRAP=

# Optional OpenAI-compatible chat model. Unset means the offline extractor.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY is also accepted as the key.
